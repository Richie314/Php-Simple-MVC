{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tests: Docker (PHP 8.3–8.5)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose -f .vscode/compose.tests.yml up --build --abort-on-container-failure --force-recreate",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Demo",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "pathMappings": {
        "/var/www/html/src": "${workspaceFolder}/src",
        "/var/www/html/demo": "${workspaceFolder}/demo",
        "/var/www/html/composer.json": "${workspaceFolder}/composer.json"
      },
      "log": false,
      "preLaunchTask": "Start container (Debugging)",
      "postDebugTask": "Stop container"
    }
  ]
}
